<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CriarVmWindows</RootNamespace>
    <AssemblyName>CriarVmWindows</AssemblyName>
    <Version>2.0.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <!-- Sem pacote MSIX: o executável corre diretamente e traz o Windows App SDK consigo. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Só afeta o dotnet publish: corta o código do .NET que a app não usa (233 MB -> cerca de 88 MB). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <!-- Trimming (dotnet publish -p:PublishTrimmed=true): o WinUI/WinRT usa reflexão, por isso estas assemblies não se cortam. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
  </ItemGroup>

  <!-- O script fica ao lado do executável, também depois de publicar. -->
  <ItemGroup>
    <Content Include="..\win10vm.ps1" Link="win10vm.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>


